<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>

<AnchorPane prefHeight="514.0" prefWidth="757.0" xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1" fx:controller="manrique.tareas.controlador.IndexControlador">
   <children>
      <Label layoutX="249.0" layoutY="46.0" text="Sistema De Tareas" textFill="#da5454">
         <font>
            <Font name="Arial Black" size="25.0" />
         </font></Label>
      <TableView fx:id="tareaTabla" layoutX="249.0" layoutY="115.0" onMouseClicked="#cargarTareaFormulario" prefHeight="220.0" prefWidth="441.0">
        <columns>
          <TableColumn fx:id="idTareaColumna" prefWidth="75.0" text="Id" />
          <TableColumn fx:id="nombreTareaColumna" prefWidth="75.0" text="Tarea" />
            <TableColumn fx:id="responsableColumna" prefWidth="75.0" text="Responsable" />
            <TableColumn fx:id="estatusColumna" prefWidth="75.0" text="Estatus" />
        </columns>
      </TableView>
      <AnchorPane layoutX="28.0" layoutY="115.0" prefHeight="200.0" prefWidth="200.0">
         <children>
            <Label layoutX="19.0" layoutY="14.0" text="Tarea" />
            <Label layoutX="19.0" layoutY="76.0" text="Responsable" />
            <Label layoutX="15.0" layoutY="138.0" text="Estatus" />
            <TextField fx:id="nombreTareaTexto" layoutX="14.0" layoutY="38.0" />
            <TextField fx:id="responsableTexto" layoutX="14.0" layoutY="103.0" />
            <TextField fx:id="estatusTexto" layoutX="14.0" layoutY="161.0" />
         </children>
      </AnchorPane>
      <AnchorPane layoutX="28.0" layoutY="375.0" prefHeight="98.0" prefWidth="686.0">
         <children>
            <Button fx:id="agregarBoton" layoutX="75.0" layoutY="37.0" mnemonicParsing="false" onAction="#agregarTarea" text="Agregar" />
            <Button fx:id="modificarBoton" layoutX="211.0" layoutY="37.0" mnemonicParsing="false" onAction="#modificarTarea" text="Modificar" />
            <Button fx:id="eliminarBoton" layoutX="364.0" layoutY="37.0" mnemonicParsing="false" onAction="#eliminarTarea" text="Eliminar" />
            <Button fx:id="limpiarBoton" layoutX="513.0" layoutY="37.0" mnemonicParsing="false" onAction="#limpiarFormulario" text="Limpiar Formulario" />
         </children>
      </AnchorPane>
   </children>
</AnchorPane>
